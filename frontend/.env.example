# Base URL of the backend API.
# Local development:
VITE_API_URL=http://localhost:5000/api
# Production (backend on Render):
# VITE_API_URL=https://my-prep-mart-api-39nk.onrender.com/api


# (Optional) Google OAuth Web Client ID for "Back up / Restore to Google Drive".
# There is already a built-in default in src/context/SettingsContext.jsx
# (DEFAULT_GOOGLE_CLIENT_ID). Setting this env var overrides that default and is
# the recommended way for white-label deployments to use their own Google project.
# VITE_GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com
